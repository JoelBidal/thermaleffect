---
interface Props {
  name: string;
  label: string;
  min: number;
  max: number;
  step: number;
  unit?: string;
  decimals?: number;
}
const { name, label, min, max, step, unit = '', decimals = 1 } = Astro.props;
---

<label class="field">
  <span class="field-row">
    <span class="field-label">{label}</span>
    <output data-output={name} data-unit={unit} data-decimals={decimals}></output>
  </span>
  <input type="range" data-key={name} min={min} max={max} step={step} />
</label>
